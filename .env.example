# live 模式环境变量名参考。代码不读取任何 .env 文件——凭据与配置只经运行时
# 进程环境变量注入（PowerShell: $env:MIMO_API_KEY='…'），禁止把真实 Key 写入任何文件。
# 解析顺序：agent 单列项（非空）→ 通用 MIMO_* → 内置默认。

# ===== 通用默认 =====
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/anthropic
MIMO_MODEL_ID=mimo-v2.6-pro

# ===== 每个专家 agent 单列接口（可独立换 Key/端点/型号；留空回退上方默认）=====
PR_ANALYST_API_KEY=
PR_ANALYST_BASE_URL=
PR_ANALYST_MODEL_ID=

OPERATOR_API_KEY=
OPERATOR_BASE_URL=
OPERATOR_MODEL_ID=

DIRECTOR_API_KEY=
DIRECTOR_BASE_URL=
DIRECTOR_MODEL_ID=

REVIEWER_API_KEY=
REVIEWER_BASE_URL=
REVIEWER_MODEL_ID=

SCOUT_API_KEY=
SCOUT_BASE_URL=
SCOUT_MODEL_ID=

ANALYST_API_KEY=
ANALYST_BASE_URL=
ANALYST_MODEL_ID=

AUDIENCE_API_KEY=
AUDIENCE_BASE_URL=
AUDIENCE_MODEL_ID=
