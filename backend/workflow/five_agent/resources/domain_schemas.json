      "title": "Evidence Date"
     },
     "hypothesis": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Hypothesis",
      "type": "string"
     }
    },
    "required": [
     "id",
     "angle",
     "audience_problem",
     "account_fit",
     "source_refs",
     "evidence_date",
     "hypothesis"
    ],
    "title": "Opportunity",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "opportunities": {
    "items": {
     "$ref": "#/$defs/Opportunity"
