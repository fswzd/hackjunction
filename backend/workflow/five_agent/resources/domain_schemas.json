      "$ref": "#/$defs/EditScope"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "input_mode",
   "objective",
   "audience",
   "platform",
   "format",
   "core_promise",
   "requirements",
   "material_ids",
   "open_questions",
   "route",
   "length_rule",
