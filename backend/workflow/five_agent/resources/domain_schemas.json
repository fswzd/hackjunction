 "OpportunitySet": {
  "$defs": {
   "Opportunity": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
     },
     "angle": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Angle",
      "type": "string"
     },
     "audience_problem": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Audience Problem",
      "type": "string"
     },
     "account_fit": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Account Fit",
      "type": "string"
     },
     "source_refs": {
      "items": {
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
